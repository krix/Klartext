{
  "name": "klartext",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ruhige Rechtschreib-Trainings-PWA mit TTS, Handschrift-Prüfung und lokalem Fortschritt",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.0"
  }
}
